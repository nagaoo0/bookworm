# Copy to .env and fill in values
POSTGRES_DB=bookworm
POSTGRES_USER=bookworm
POSTGRES_PASSWORD=changeme

# Optional — without a key, Google Books API works at reduced quota
GOOGLE_BOOKS_API_KEY=
RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_SECRET=your_secret_key_here
RECAPTCHA_MIN_SCORE=0.5

# Ports on the host
API_PORT=3000
FRONTEND_PORT=8080

# Used by the frontend nginx to proxy /api → api container
VITE_API_BASE=/api

# Set to "production" to enable secure cookies and strict CORS
NODE_ENV=development

# Comma-separated list of allowed frontend origins — REQUIRED in production
# Example: ALLOWED_ORIGINS=https://books.yourdomain.com
ALLOWED_ORIGINS=http://localhost:8080

# Optional: cap the on-disk cover cache (MB). When set, the oldest cached covers
# are deleted on startup and every 24h until the cache is under the cap.
# COVERS_MAX_MB=500

# Registration is open by default. Set to "true" for invite-only: every account
# except the very first (admin) must supply an invite code created in Settings.
REQUIRE_INVITE=false

# Encrypts integration credentials (Calibre-Web / Audiobookshelf / Kobo) at rest with
# AES-256-GCM. 32-byte key as hex or base64 (e.g. `openssl rand -hex 32`) or any passphrase.
# Recommended; if unset, credentials are stored in plaintext and a warning is logged.
INTEGRATIONS_KEY=

# Optional, comma-separated hostnames integrations may connect to, e.g.
# INTEGRATION_ALLOWED_HOSTS=calibre.lan,192.168.1.20
# Recommended for multi-user instances (otherwise any user can point an
# integration at any host on your LAN).
INTEGRATION_ALLOWED_HOSTS=

# Number of reverse-proxy hops to trust for X-Forwarded-For (default: 1).
# Set to "false" if the API is exposed directly with no proxy in front.
TRUST_PROXY=1

# Optional: time zone of the API's database sessions (IANA name). Date-only
# values like a read's finish date are interpreted in it. Default: UTC.
# PG_TIMEZONE=UTC
